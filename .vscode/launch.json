{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Flask app",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "env": {
        "FLASK_ENV": "development",
        "FLASK_DEBUG": "1"
      },
      "justMyCode": true,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Running on http://127.0.0.1:(\\d+)",
        "uriFormat": "http://127.0.0.1:%s"
      }
    }
  ]
}
